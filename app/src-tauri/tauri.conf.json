{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Knowledge QA",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devPath": "http://localhost:5173",
    "distDir": "../frontend/dist"
  },
  "tauri": {
    "windows": [
      {
        "title": "Knowledge QA",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "bundle": {
      "active": true,
      "category": "Productivity",
      "shortDescription": "Personal knowledge base assistant",
      "longDescription": "Knowledge QA combines your private knowledge base with multiple AI providers.",
      "targets": [
        "msi",
        "nsis",
        "app",
        "dmg"
      ],
      "identifier": "com.knowledgeqa.app",
      "macOS": {
        "minimumSystemVersion": "10.15",
        "frameworks": []
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "http://timestamp.digicert.com"
      },
      "resources": [
        "../backend"
      ]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:* https://*"
    }
  }
}
